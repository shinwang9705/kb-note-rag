# ---------- 基础 ----------
NODE_ENV=development
APP_NAME=kb-note
SERVER_HOST=127.0.0.1
SERVER_PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
# 仅在明确受信任的反向代理部署下开启
TRUST_PROXY=false

# ---------- 存储 ----------
DATA_DIR=./data
# DB_PATH=./data/kb.db
SQLITE_DRIVER=node            # node | better | auto
# SQLITE_VEC_PATH=./data/lib/vec0

# ---------- 认证 ----------
# 生产环境必须替换为 `openssl rand -base64 48` 的输出，否则 fail-fast
JWT_SECRET=
JWT_EXPIRES_IN=7d
# 生产环境必须显式配置至少 32 字符；不要随意更换已有数据使用的加密密钥
# 若旧系统未设置 SECRETS_KEY，则原加密密钥为原 JWT_SECRET，迁移前应先安全保留
# SECRETS_KEY=
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASS=
ALLOW_REGISTER=true
# 登录限流：连续失败 N 次锁 M 分钟
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# ---------- 配额与安全 ----------
MAX_DOCUMENTS_PER_USER=500
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
MAX_TOTAL_GB=2                 # 单用户总存储上限（GiB）
ALLOWED_ORIGINS=*

# ---------- Embedding ----------
EMBEDDING_PROVIDER=local        # local | api | none
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_CACHE_DIR=./data/models
HF_ENDPOINT=https://hf-mirror.com
# 云端模式（EMBEDDING_PROVIDER=api 时才需要）
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_BATCH_SIZE=16

# ---------- 检索 ----------
SEARCH_TOP_K=30
SEARCH_FINAL_K=10
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ---------- Rerank（重排序，增强能力；失败自动降级为不重排） ----------
RERANK_PROVIDER=api          # api | none（默认 api，配 DASHSCOPE_API_KEY 即启用）
RERANK_API_BASE=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
DASHSCOPE_API_KEY=           # 阿里云 DashScope Key（rerank 专用；embedding 用 EMBEDDING_API_KEY）
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TOPN=20
RERANK_TOPK=5
RERANK_TIMEOUT_MS=10000
RERANK_RETURN_DOCUMENTS=false   # true 时上游返回原文 document.text（本地已有原文，默认关）

# ---------- LLM（RAG 问答） ----------
LLM_PROVIDER=none            # none | deepseek
LLM_API_BASE=https://api.deepseek.com
# 用户自定义模型端点仅允许官方来源、上面的全局端点或以下管理员授权来源
# 多个来源用逗号分隔，包含协议和端口；只授权可信网关
# PROVIDER_ALLOWED_ORIGINS=https://gateway.example.com
LLM_API_KEY=                 # 留空 = 问答关闭（/api/chat 返回 404 LLM_NOT_CONFIGURED）
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=30000
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_CONTEXT_TOPK=5

# ---------- 日志 ----------
LOG_LEVEL=debug
# LOG_FILE=

# ---------- 共享链接 ----------
SHARE_BASE_URL=http://localhost:5173    # 生产环境改为 https://<web 域名>
